{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "showcase": {
      "projectType": "application",
      "root": "apps/showcase",
      "sourceRoot": "apps/showcase/src",
      "prefix": "showcase",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/showcase",
            "index": "apps/showcase/src/index.html",
            "browser": "apps/showcase/src/main.ts",
            "tsConfig": "apps/showcase/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/showcase/public"
              }
            ],
            "styles": ["apps/showcase/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "baseHref": "/ngrx-offline/",
              "serviceWorker": "apps/showcase/ngsw-config.json",
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "28kB",
                  "maximumError": "36kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "baseHref": "/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "showcase:build:production"
            },
            "development": {
              "buildTarget": "showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/showcase/tsconfig.spec.json",
            "include": ["apps/showcase/src/**/*.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/showcase/src/**/*.ts", "apps/showcase/src/**/*.html"]
          }
        }
      }
    },
    "ngrx-offline": {
      "projectType": "library",
      "root": "projects/ngrx-offline",
      "sourceRoot": "projects/ngrx-offline/src",
      "prefix": "ngx-offline",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngrx-offline/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngrx-offline/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngrx-offline/tsconfig.spec.json",
            "include": [
              "projects/ngrx-offline/src/**/*.spec.ts",
              "projects/ngrx-offline/worker/**/*.spec.ts",
              "projects/ngrx-offline/testing/**/*.spec.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ngrx-offline/**/*.ts", "projects/ngrx-offline/**/*.html"]
          }
        }
      }
    }
  }
}
