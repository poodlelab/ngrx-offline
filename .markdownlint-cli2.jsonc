{
  "config": {
    "MD013": false,
    "MD034": false,
    "MD024": {
      "siblings_only": true,
    },
    "MD033": {
      "allowed_elements": ["details", "summary"],
    },
  },
  "ignores": [
    "**/node_modules/**",
    ".angular/**",
    ".changeset/*.md",
    "dist/**",
    "etc/*.api.md",
    "temp/**",
  ],
}
