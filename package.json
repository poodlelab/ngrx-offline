{
  "name": "ngrx-offline-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the @poodlelab/ngrx-offline library and showcase",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "pnpm": ">=10.34.5 <11"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve showcase",
    "build": "pnpm build:library && pnpm build:showcase",
    "build:library": "ng build ngrx-offline",
    "build:showcase": "ng build showcase && pnpm build:showcase-worker",
    "build:showcase-worker": "esbuild apps/showcase/src/offline-service-worker.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=dist/showcase/browser/offline-service-worker.js",
    "test:library": "ng test ngrx-offline --watch=false",
    "test:contracts": "vitest run --dir apps/demo-api/src",
    "test:api": "vitest run --config apps/demo-api/vitest.config.ts",
    "test:showcase": "ng test showcase --watch=false",
    "test": "pnpm test:library && pnpm test:showcase && pnpm test:contracts && pnpm test:api",
    "test:coverage": "ng test ngrx-offline --watch=false --coverage",
    "test:e2e": "pnpm build && playwright test",
    "lint:library": "ng lint ngrx-offline",
    "lint:showcase": "ng lint showcase",
    "lint:contracts": "eslint apps/demo-api/src/**/*.ts apps/demo-api/test/**/*.ts apps/demo-api/vitest.config.ts playwright.config.ts",
    "lint:code": "pnpm lint:library && pnpm lint:showcase && pnpm lint:contracts",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint": "pnpm lint:code && pnpm lint:markdown",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:workspace": "tsc --build --pretty false",
    "typecheck:boundaries": "tsc -p projects/ngrx-offline/core/tsconfig.json --pretty false && tsc -p projects/ngrx-offline/indexeddb/tsconfig.json --pretty false && tsc -p projects/ngrx-offline/worker/tsconfig.json --pretty false && tsc -p projects/ngrx-offline/testing/tsconfig.json --pretty false",
    "typecheck:contracts": "tsc -p apps/demo-api/tsconfig.json --pretty false && tsc -p apps/demo-api/tsconfig.worker.json --pretty false && tsc -p apps/demo-api/test/tsconfig.json --pretty false",
    "typecheck:browser": "tsc -p e2e/browser/tsconfig.json --pretty false",
    "typecheck": "pnpm typecheck:workspace && pnpm typecheck:boundaries && pnpm typecheck:contracts && pnpm typecheck:browser",
    "contract:generate": "tsx apps/demo-api/src/generate-json-schema.ts",
    "contract:check": "tsx apps/demo-api/src/generate-json-schema.ts --check && redocly lint demo-api@v1",
    "api:dev": "wrangler dev --config apps/demo-api/wrangler.jsonc",
    "api:migrate:local": "wrangler d1 migrations apply ngrx-offline-demo --local --config apps/demo-api/wrangler.jsonc",
    "api:migrate:remote": "wrangler d1 migrations apply ngrx-offline-demo --remote --config apps/demo-api/wrangler.jsonc",
    "api:deploy": "wrangler deploy --config apps/demo-api/wrangler.jsonc",
    "api:types": "wrangler types --config apps/demo-api/wrangler.jsonc",
    "api:report": "node scripts/api-reports.mjs --local",
    "api:check": "node scripts/api-reports.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm contract:check && pnpm test && pnpm build && pnpm api:check && pnpm package:verify",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/service-worker": "21.2.19",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260810.1",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.58.12",
    "@ngrx/effects": "21.1.1",
    "@ngrx/store": "21.1.1",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.0",
    "@types/node": "22.20.1",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "28.1.0",
    "markdownlint-cli2": "0.23.2",
    "ng-packagr": "21.2.7",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "workerd"
    ]
  }
}
